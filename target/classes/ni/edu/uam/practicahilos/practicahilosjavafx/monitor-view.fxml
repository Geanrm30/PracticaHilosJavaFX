<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.practicahilosjavafx.MonitorController"
      alignment="CENTER"
      spacing="20"
      prefWidth="560"
      prefHeight="450">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Monitor de procesos - NicaData Solutions"
           style="-fx-font-size: 22px;"/>

    <!-- Clientes -->
    <VBox spacing="8" alignment="CENTER">
        <Label text="Clientes (100 registros)" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblEstadoClientes" text="Esperando inicio"/>
        <ProgressBar fx:id="barraClientes" progress="0" prefWidth="450"/>
        <Label fx:id="lblPorcentajeClientes" text="0%"/>
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarClientes" text="Iniciar" onAction="#iniciarClientes"/>
            <Button fx:id="btnDetenerClientes" text="Detener" onAction="#detenerClientes" disable="true"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Productos -->
    <VBox spacing="8" alignment="CENTER">
        <Label text="Productos (50 registros)" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblEstadoProductos" text="Esperando inicio"/>
        <ProgressBar fx:id="barraProductos" progress="0" prefWidth="450"/>
        <Label fx:id="lblPorcentajeProductos" text="0%"/>
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarProductos" text="Iniciar" onAction="#iniciarProductos"/>
            <Button fx:id="btnDetenerProductos" text="Detener" onAction="#detenerProductos" disable="true"/>
        </HBox>
    </VBox>
</VBox>
